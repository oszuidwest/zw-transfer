# Copy this file to .env and fill in deployment-specific values.
# Compose defaults provide everything else; see the ${VAR:-default}
# expressions in docker-compose.yml to discover all available overrides.

APP_HOSTNAME=transfer.example.org
APP_NAME=ZuidWest Transfer
APP_URL=https://transfer.example.org

SMTP_ENABLED=true
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_EMAIL=transfer@example.org
SMTP_USERNAME=transfer@example.org
SMTP_PASSWORD=

OIDC_ENABLED=true
OIDC_DISCOVERY_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_USERNAME_CLAIM=name
