# Copy this file to .env and fill in the required deployment values.
# Pingvin application settings are rendered from docker-compose.yml into
# /opt/app/config.yaml. To override a supported default, look up its
# ${VAR:-default} expression in docker-compose.yml and add VAR=... here.

# Public hostname for this deployment.
APP_HOSTNAME=

# SMTP — enabled by default for this deployment; fill the blank values below.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_EMAIL=
SMTP_PASSWORD=

# OIDC — enabled by default for SSO-only login; fill the blank values below.
OIDC_ENABLED=true
OIDC_DISCOVERY_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Common optional overrides:
# APP_NAME=ZuidWest Transfer
# APP_URL=https://transfer.example.org
# SMTP_PORT=587
# SMTP_USERNAME=transfer@example.org
# OIDC_USERNAME_CLAIM=name
