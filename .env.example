# Copy this file to .env and fill in the required values.
# Defaults for everything else live in docker-compose.yml; to override
# any other Pingvin knob, look up the ${VAR:-default} expression there
# and add VAR=... below.

# Public hostname for this deployment.
APP_HOSTNAME=

# SMTP — required for outgoing email.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_EMAIL=
SMTP_PASSWORD=

# OIDC — required for SSO.
OIDC_ENABLED=true
OIDC_DISCOVERY_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
